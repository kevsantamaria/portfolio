---
const experiences = [
  {
    role: 'Software Engineer',
    company: 'University of Matanzas',
    period: 'Jan 2025 — Present',
    description:
      'Develop and maintain web applications and digital platforms for the university. Ensure performance, accessibility, responsiveness, and a seamless user experience across academic and institutional systems.',
  },
]
---

<h2 class="section-header">Experience</h2>

<section class="flex flex-col gap-8 mb-8">
  {
    experiences.map((exp) => (
      <div class="bg-custom-card rounded-lg p-4 sm:p-5 shadow transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-1">
          <h3 class="font-bold text-sm sm:text-lg text-primary-custom-text">
            {exp.role}
          </h3>
          <span class="text-xs text-custom-secondary font-medium whitespace-nowrap">
            {exp.period}
          </span>
        </div>
        <p class="text-xs sm:text-sm text-custom-primary font-medium mb-2">
          {exp.company}
        </p>
        <p class="text-xs sm:text-sm text-secondary-custom-text leading-relaxed">
          {exp.description}
        </p>
      </div>
    ))
  }
</section>
