---
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

const {
  name,
  description,
  descriptionTwo,
  img,
  imgAlt,
  githubLink,
  liveDemoLink,
  extraIcons,
} = Astro.props
---

<article
  class="group flex flex-col md:flex-row rounded-lg bg-custom-card shadow transition-all duration-300 hover:shadow-lg hover:-translate-y-1 overflow-hidden"
>
  <aside
    class="w-full md:w-[300px] h-52 md:h-auto md:min-h-[250px] overflow-hidden"
  >
    <Image
      src={img}
      alt={imgAlt}
      aria-hidden="true"
      class="w-full h-full object-cover select-none"
      fetchpriority="high"
    />
  </aside>

  <main class="w-full p-5 flex flex-col">
    <div class="w-full flex items-center justify-between">
      <h3 class="font-bold text-lg sm:text-xl text-text-main">{name}</h3>
      <div class="flex gap-3 items-center">
        <a
          href={githubLink}
          title="Ir al repositorio"
          target="_blank"
          rel="noopener noreferrer"
          class="custom-link hover:scale-110 transition-transform"
        >
          <Icon name="tabler:brand-github" size={24} />
        </a>
        {
          liveDemoLink && (
            <a
              href={liveDemoLink}
              title="Visitar la demo"
              target="_blank"
              rel="noopener noreferrer"
              class="custom-link hover:scale-110 transition-transform"
            >
              <Icon name="tabler:link" size={24} />
            </a>
          )
        }
      </div>
    </div>

    <div class="flex flex-wrap gap-2 mt-3">
      {extraIcons?.map((icon: string) => <Icon name={icon} size={24} />)}
      <Icon name="skill-icons:react-dark" size={24} />
      <Icon name="skill-icons:tailwindcss-dark" size={24} />
      <Icon name="skill-icons:vite-dark" size={24} />
      <Icon name="skill-icons:html" size={24} />
      <Icon name="skill-icons:css" size={24} />
    </div>

    <div class="mt-4 space-y-2">
      <p class="text-sm text-secondary-custom-text leading-relaxed">
        {description}
      </p>
      {
        descriptionTwo && (
          <p class="text-sm text-secondary-custom-text leading-relaxed">
            {descriptionTwo}
          </p>
        )
      }
    </div>
  </main>
</article>
