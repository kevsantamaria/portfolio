---
import { Icon } from 'astro-icon/components'
import CopyEmailBtn from '@/components/ui/CopyEmailBtn'
import DownloadCVBtn from './ui/DownloadCVBtn'
import voxelAvatar from '@/assets/voxel-avatar.webp'
import { Image } from 'astro:assets'
---

<section
  class="container bg-custom-card mt-10 shadow rounded-lg p-4 sm:p-8 flex justify-around items-start gap-4 transition-all duration-300 hover:shadow-lg hover:-translate-y-1"
>
  <main class="flex flex-col items-left">
    <div class="mb-2 sm:mb-6">
      <h1 class="font-bold text-[22px] sm:text-3xl">Kevin Santamaria</h1>
      <p class="text-xs sm:text-sm text-secondary-custom-text">
        Full-stack Developer
      </p>
      <p class="text-xs sm:text-sm text-secondary-custom-text">
        + 2 years of experience
      </p>
    </div>

    <div class="flex flex-col gap-2">
      <CopyEmailBtn client:idle />
      <div class="flex gap-1.5 items-center sm:mt-2">
        <a
          href="https://github.com/kevsantamaria"
          title="GitHub Profile"
          target="_blank"
          rel="noopener noreferrer"
          class="custom-link"><Icon name="tabler:brand-github" size={22} /></a
        >
        <a
          href="https://linkedin.com/in/kevsantamaria/"
          title="LinkedIn Profile"
          target="_blank"
          rel="noopener noreferrer"
          class="custom-link"><Icon name="tabler:brand-linkedin" size={22} /></a
        >
        <a
          href="https://t.me/kevsd03"
          title="Telegram Profile"
          target="_blank"
          rel="noopener noreferrer"
          class="custom-link"><Icon name="tabler:brand-telegram" size={22} /></a
        >
        <DownloadCVBtn client:idle />
      </div>
    </div>
  </main>
  <aside class="max-h-[150px] max-w-[100px] sm:max-w-[150px] -mt-10 sm:mt-0">
    <Image
      src={voxelAvatar}
      alt="Voxel-art avatar of Kevin"
      aria-hidden="true"
      class="h-full w-full object-cover rounded-lg select-none"
    />
  </aside>
</section>
