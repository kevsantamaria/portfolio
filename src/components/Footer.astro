---
import { CONFIG } from '@/config/config'
import { Icon } from 'astro-icon/components'
---

<section class="flex justify-center items-center gap-2 !text-gray-500">
  <span>Made by Kevin Santamaria</span>
  <div class="flex gap-1">
    <a
      href={CONFIG.github}
      title="GitHub Profile"
      target="_blank"
      rel="noopener noreferrer"
      class="custom-link-gray"><Icon name="tabler:brand-github" size={22} /></a
    >
    <a
      href={CONFIG.linkedin}
      title="LinkedIn Profile"
      target="_blank"
      rel="noopener noreferrer"
      class="custom-link-gray"
      ><Icon name="tabler:brand-linkedin" size={22} /></a
    >
    <a
      href={CONFIG.telegram}
      title="Telegram Profile"
      target="_blank"
      rel="noopener noreferrer"
      class="custom-link-gray"
      ><Icon name="tabler:brand-telegram" size={22} /></a
    >
  </div>
</section>
