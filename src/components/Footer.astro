    <a
      href="https://www.linkedin.com/in/kevsantamaria/"
      title="LinkedIn Profile"
      target="_blank"
      rel="noopener noreferrer"
      class="custom-link-gray"
      ><Icon name="tabler:brand-linkedin" size={22} /></a
    >
    <a
      href="https://t.me/kevsd03"
      title="Telegram Profile"
      target="_blank"
      rel="noopener noreferrer"
