---
import CopyEmailBtn from '@/components/ui/CopyEmailBtn'
import DownloadCVBtn from '@/components/ui/DownloadCVBtn'
import kevinPicture from '@/assets/kevin.webp'
import { Image } from 'astro:assets'
---

<h2 class="section-header">About Me</h2>

<section class="flex flex-col sm:flex-row gap-4">
  <aside class="h-full mx-auto">
    <Image
      src={kevinPicture}
      alt="Kevin Santamaria"
      aria-hidden="true"
      quality={60}
      class="w-[120px] h-[120px] sm:w-[700px] sm:h-auto object-cover object-center rounded-lg select-none"
    />
  </aside>
  <main class="flex flex-col gap-4">
    <p>
      My name is Kevin Santamaria, I'm 22 years old and a Computer Science
      Engineering student. I'm a full-stack developer, with a primary emphasis
      on Frontend. I specialize in building fast, accessible interfaces with
      careful design, while maintaining the technical capability to implement
      and manage the Backend logic that supports them. I've developed personal
      and academic projects that have allowed me to apply and expand my
      knowledge in the latest web technologies.
    </p>
    <p>
      My goal is to continue growing as a developer and find opportunities where
      I can demonstrate my skills and contribute to projects with real impact.
    </p>
    <div
      class="flex sm:flex-row gap-2 items-center justify-center sm:justify-start"
    >
      <CopyEmailBtn client:idle />
      <DownloadCVBtn client:idle />
    </div>
  </main>
</section>
