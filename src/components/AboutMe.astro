---
import CopyEmailBtn from '@/components/ui/CopyEmailBtn'
import DownloadCVBtn from '@/components/ui/DownloadCVBtn'
import kevinPicture from '@/assets/kevin.webp'
import { Image } from 'astro:assets'
---

<h2 class="section-header">About Me</h2>

<section class="flex flex-col sm:flex-row-reverse gap-4 sm:h-fit">
  <aside class="h-full mx-auto">
    <Image
      src={kevinPicture}
      alt="Kevin Santamaria"
      aria-hidden="true"
      quality={60}
      loading="lazy"
      class="w-[120px] h-[120px] sm:w-[700px] sm:h-auto object-cover object-center rounded-lg select-none"
    />
  </aside>
  <main class="flex flex-col gap-4 justify-center">
    <p>
      I'm Kevin Santamaria, a 23-year-old Computer Engineering student and
      Frontend Developer. I specialize in crafting fast, accessible, and
      high-fidelity interfaces with a sharp eye for design. While my focus is in
      the frontend, I possess the technical depth to build and manage the
      backend logic that powers seamless user experiences. From academic
      challenges to personal projects, I’m constantly pushing the boundaries of
      the latest web technologies.
    </p>
    <p>
      My goal is to continue growing as a developer and find opportunities where
      I can demonstrate my skills and contribute to projects with real impact.
    </p>
    <div
      class="flex sm:flex-row gap-2 items-center justify-center sm:justify-start"
    >
      <CopyEmailBtn client:idle />
      <DownloadCVBtn client:idle />
    </div>
  </main>
</section>
