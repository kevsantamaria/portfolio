---
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import '@/styles/global.css'
---

<Layout title="404 - Page not found">
  <section class="flex flex-col items-center justify-center min-h-[100vh] px-4">
    <div
      class="container max-w-2xl p-8 sm:p-12 flex flex-col items-center text-center"
    >
      <div class="mb-6 text-custom-secondary animate-bounce">
        <Icon name="tabler:error-404" size={100} />
      </div>
      <h1 class="font-bold text-4xl sm:text-6xl mb-2 text-primary-custom-text">
        Oops!
      </h1>
      <p class="section-header text-2xl mt-0">Page not found</p>
      <p class="text-secondary-custom-text mb-8 max-w-md">
        The page you were looking for doesn't exist or has been moved.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/"
          class="download-cv-btn flex items-center gap-2 no-underline text-primary-custom-text"
        >
          <Icon name="tabler:home" size={20} />
          Back to home
        </a>
      </div>
    </div>

    <span
      class="absolute -z-10 text-[15rem] font-bold opacity-[0.02] pointer-events-none select-none"
    >
      404
    </span>
  </section>
</Layout>

<style>
  .download-cv-btn {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
</style>
