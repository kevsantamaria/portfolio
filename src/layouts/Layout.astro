---
import { Particles } from '@/components/ui/shadcn-io/particles'
import { CONFIG } from '@/config/config'
import '@fontsource/alan-sans'
import alanSansWoff2 from '@fontsource/alan-sans/files/alan-sans-latin-400-normal.woff2?url'

const {
  title = 'Kevin Santamaria | Frontend Developer',
  description = 'Kevin Santamaria — Frontend Developer: Focused on fast, accessible interfaces and well-structured web systems.',
  websiteUrl = CONFIG.websiteUrl,
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4f45ba" />
    <meta
      property="og:logo"
      content={CONFIG.websiteUrl + '/logo.png'}
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={websiteUrl} />
    <meta
      property="og:image"
      content={CONFIG.websiteUrl + '/og-image.jpeg'}
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={CONFIG.websiteUrl + '/og-image.jpeg'}
    />

    <meta
      name="google-site-verification"
      content="DlqDaxyzuvrH21h7xiyWu0AncQ52Ilg7iGXN_0odF0M"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Kevin Santamaria",
        "url": CONFIG.websiteUrl,
        "jobTitle": "Frontend Developer",
        "description": "Frontend developer with a focus in crafting fast, accessible, and high-fidelity web interfaces",
        "image": CONFIG.websiteUrl + '/og-image.jpeg',
        "sameAs": [
          "https://github.com/kevsantamaria",
          "https://linkedin.com/in/kevsantamaria/",
          "https://www.instagram.com/kevin_sd03/"
        ]
      }
    </script>

    <link rel="icon" href="./favicon.ico" />
    <link rel="canonical" href={CONFIG.websiteUrl + '/'} />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={alanSansWoff2}
      crossorigin="anonymous"
    />
    <title>{title}</title>

    <script is:inline>
      const setDarkMode = () => {
        const theme =
          localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light')

        document.documentElement.classList.toggle('dark', theme === 'dark')
      }

      setDarkMode()
    </script>
  </head>
  <body
    class="relative text-sm h-full selection:bg-custom-secondary selection:text-gray-800 scroll-smooth"
  >
    <main class="max-w-[600px] mx-2 sm:mx-auto">
      <slot />
    </main>
    <Particles
      client:load
      className="absolute inset-0 -z-10"
      quantity={120}
      ease={80}
      staticity={40}
      color="#ffffff"
      size={0.8}
    />
  </body>
</html>
